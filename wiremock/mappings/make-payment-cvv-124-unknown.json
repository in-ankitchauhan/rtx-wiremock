{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/V2/MakeOneTimePayment",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.PaymentMethod.SecurityCode",
          "equalTo": "124"
        }
      }
    ]
  },
  "response": {
    "status": 400,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "Status": "Unknown",
      "PestPacBalanceUpdateStatus": "NotAttempted"
    }
  }
}
